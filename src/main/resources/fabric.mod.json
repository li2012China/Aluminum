	"authors": [
		"li2012China"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/aluminum",
		"sources": "https://github.com/li2012China/aluminum"
	},
	"license": "CC-BY-NC-ND-4.0",
	"icon": "assets/aluminum/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.aluminum.li2012china.Aluminum"
		],
		"client": [
			"com.aluminum.li2012china.AluminumClient"
		],
		"fabric-datagen": [
			"com.aluminum.li2012china.AluminumDataGenerator"
		]
	},
	"mixins": [
		"aluminum.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
